# Cargo build output
target/
# NB: `target-*/` (singular member dirs) must NOT be ignored — they are
# workspace members. Only the cargo `target/` build dir is ignored.

# OS / editor noise
.DS_Store
*.swp
*~

# Compiled kernel and bootloader output
*.bin
*.elf
*.img
*.dtb
*.dtbo
*.itb
*.map
*.o
*.srec
*.uImage

# Python
__pycache__/
*.pyc

# Build/download caches (images/ holds the RPi SD image and firmware cache;
# hardware bring-up binaries under images/ are NOT committed either)
images/

# CI / vendor-tool leftovers written into the working directory
/fw.tar.gz
/config.ini
/log/
vivanta-boot/tools/log/

# Prebuilt vendor binary: build from source, see
# docs/hardware/rk3568/uboot-emmc-bringup.md
vivanta-boot/tools/rkdeveloptool
